@{
    ViewData["Title"] = "Оформление заказа";
}
@model List<LuxDustApp.Models.Cart>

    @{
    int total = 0;
    foreach (var item in Model)
    {
    total += item.Product.Price * item.Quantity;
    }
    }

    <div class="container">
        <h2>Оформление заказа</h2>

        <form method="post" action="/Checkout/PlaceOrder">
            <div class="row">
                <div class="col-md-7">
                    <!-- ...форма доставки без изменений... -->
                </div>

                <div class="col-md-5">
                    <h4>Ваш заказ</h4>
                    <ul class="list-group mb-3">
                        @foreach (var item in Model)
                        {
                        var itemTotal = item.Product.Price * item.Quantity;
                        <li class="list-group-item d-flex justify-content-between">
                            <span>@item.Product.Name × @item.Quantity</span>
                            <strong>@itemTotal руб.</strong>
                        </li>
                        }
                    </ul>

                    <p><strong>Товары:</strong> @total руб.</p>
                    <p><strong>Доставка:</strong> <span id="deliveryPrice">300</span> руб.</p>
                    <p><strong>Итого:</strong> <span id="totalPrice">@(total + 300)</span> руб.</p>

                    <button type="submit" class="btn btn-success w-100">Оформить заказ</button>
                </div>
            </div>
        </form>
    </div>

    <script>
        var total = @total;
        function toggleAddress(show) {
            document.getElementById('addressBlock').style.display = show ? 'block' : 'none';
            var delivery = show ? 300 : 0;
            document.getElementById('deliveryPrice').textContent = delivery;
            document.getElementById('totalPrice').textContent = total + delivery;
        }
    </script>
