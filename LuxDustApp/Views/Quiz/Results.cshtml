@using LuxDustApp.Models
@{
    ViewData["Title"] = "Ваша подборка";
}
@model List<LuxDustApp.Models.Product>

<h2>Ваша персональная подборка</h2>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">Бренд: @product.Brand</p>
                        <p class="card-text">Цена: @product.Price руб.</p>
                        <p class="card-text">Тип кожи: @product.SkinType</p>
                        <a href="#" class="btn btn-primary">Добавить в корзину</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p>Подходящих продуктов не найдено. Попробуйте изменить параметры анкеты.</p>
}