@{
    ViewData["Title"] = "Корзина";
}
@model List<LuxDustApp.Models.Cart>

	<div class="container">
		<h2>Корзина</h2>

		@if (Model != null && Model.Any())
		{
		<table class="table">
			<thead>
				<tr>
					<th>Товар</th>
					<th>Цена</th>
					<th>Количество</th>
					<th>Итого</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@{
				int total = 0;
				}
				@foreach (var item in Model)
				{
				var itemTotal = item.Product.Price * item.Quantity;
				total += itemTotal;
				<tr>
					<td>
						<a href="/Catalog/Details/@item.ProductId" class="profile-link">@item.Product.Name</a>
					</td>
					<td>@item.Product.Price руб.</td>
					<td>
						<div class="qty-controls">
							<button type="button" class="qty-btn" onclick="updateQuantity(@item.Id, -1, this)">−</button>
							<span class="qty-value" data-cart-id="@item.Id">@item.Quantity</span>
							<button type="button" class="qty-btn" onclick="updateQuantity(@item.Id, 1, this)">+</button>
						</div>
					</td>
					<td class="item-total" data-cart-id="@item.Id" data-price="@item.Product.Price">@itemTotal руб.</td>
					<td>
						<button type="button" class="btn btn-sm btn-danger" onclick="confirmRemove(@item.Id)">Удалить</button>
					</td>
				</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th colspan="3">Итого:</th>
					<th id="cartGrandTotal">@total руб.</th>
					<th></th>
				</tr>
			</tfoot>
		</table>

		<a href="/Checkout" class="btn btn-primary">Оформить заказ</a>
		}
		else
		{
		<p>Ваша корзина пуста. <a href="/Quiz/Step1">Пройти анкету</a> и получить подборку.</p>
		}
	</div>

	@section Scripts {
	<script src="~/js/quiz.js"></script>
	}
