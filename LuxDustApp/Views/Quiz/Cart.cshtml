@{
    ViewData["Title"] = "Корзина";
}
@model List<LuxDustApp.Models.Cart>

	<div class="container">
		<h2>Корзина</h2>

		@if (Model != null && Model.Any())
		{
		<table class="table">
			<thead>
				<tr>
					<th>Товар</th>
					<th>Цена</th>
					<th>Количество</th>
					<th>Итого</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
				@{
				int total = 0;
				}
				@foreach (var item in Model)
				{
				var itemTotal = item.Product.Price * item.Quantity;
				total += itemTotal;
				<tr>
					<td>@item.Product.Name</td>
					<td>@item.Product.Price руб.</td>
					<td>@item.Quantity</td>
					<td>@itemTotal руб.</td>
					<td>
						<a href="/Quiz/RemoveFromCart?cartId=@item.Id" class="btn btn-sm btn-danger">Удалить</a>
					</td>
				</tr>
				}
			</tbody>
			<tfoot>
				<tr>
					<th colspan="3">Итого:</th>
					<th>@total руб.</th>
					<th></th>
				</tr>
			</tfoot>
		</table>

		<a href="#" class="btn btn-primary">Оформить заказ</a>
		}
		else
		{
		<p>Ваша корзина пуста. <a href="/Quiz/Step1">Пройти анкету</a> и получить подборку.</p>
		}
	</div>
