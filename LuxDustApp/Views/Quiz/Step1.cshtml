@{
    ViewData["Title"] = "Анкета — LuxDust";
}

<div class="container">
    <h2>Давайте познакомимся!</h2>
    <p id="stepIndicator">Шаг 1 из 15</p>

    <div style="width: 100%; background-color: #e0e0e0; height: 8px; margin-bottom: 20px;">
        <div id="progressBar" style="width: 6.6%; background-color: #007bff; height: 8px;"></div>
    </div>

    <form id="quizForm" method="post" action="/Quiz/Results">

        <div class="step" data-step="1">
            <label>1. Какой у вас тип кожи?</label>
            <div>
                <label><input type="radio" name="SkinType" value="Сухая" /> Сухая</label><br />
                <label><input type="radio" name="SkinType" value="Жирная" /> Жирная</label><br />
                <label><input type="radio" name="SkinType" value="Комбинированная" /> Комбинированная</label><br />
                <label><input type="radio" name="SkinType" value="Нормальная" /> Нормальная</label><br />
                <label><input type="radio" name="SkinType" value="Чувствительная" /> Чувствительная</label><br />
                <label><input type="radio" name="SkinType" value="Обезвоженная" /> Обезвоженная</label><br />
                <label><input type="radio" name="SkinType" value="Склонная к куперозу" /> Склонная к куперозу</label><br />
                <label><input type="radio" name="SkinType" value="Не знаю / хочу узнать" /> Не знаю / хочу узнать</label>
            </div>
        </div>

        <div class="step" data-step="2" style="display:none;">
            <label>2. Сколько вам лет?</label>
            <div>
                <label><input type="radio" name="Age" value="18" /> до 20</label><br />
                <label><input type="radio" name="Age" value="25" /> 20–30</label><br />
                <label><input type="radio" name="Age" value="35" /> 30–40</label><br />
                <label><input type="radio" name="Age" value="45" /> 40–50</label><br />
                <label><input type="radio" name="Age" value="55" /> 50+</label>
            </div>
        </div>

        <div class="step" data-step="3" style="display:none;">
            <label>3. Ваш бюджет на уход в месяц</label>
            <div>
                <label><input type="radio" name="Budget" value="1000" /> до 1000 руб.</label><br />
                <label><input type="radio" name="Budget" value="3000" /> 1000–3000 руб.</label><br />
                <label><input type="radio" name="Budget" value="10000" /> 3000–10000 руб.</label><br />
                <label><input type="radio" name="Budget" value="25000" /> 10000–25000 руб.</label><br />
                <label><input type="radio" name="Budget" value="999999" /> Без лимита</label>
            </div>
        </div>

        <div class="step" data-step="4" style="display:none;">
            <label>4. Какие проблемы вас беспокоят? (можно несколько)</label>
            <div>
                <label><input type="checkbox" name="Problems" value="Акне" /> Акне</label><br />
                <label><input type="checkbox" name="Problems" value="Пигментация" /> Пигментация</label><br />
                <label><input type="checkbox" name="Problems" value="Морщины" /> Морщины</label><br />
                <label><input type="checkbox" name="Problems" value="Купероз" /> Купероз</label><br />
                <label><input type="checkbox" name="Problems" value="Тусклый цвет" /> Тусклый цвет</label><br />
                <label><input type="checkbox" name="Problems" value="Гиперчувствительность" /> Гиперчувствительность</label><br />
                <label><input type="checkbox" name="Problems" value="Чёрные точки" /> Чёрные точки</label><br />
                <label><input type="checkbox" name="Problems" value="Сухость/Шелушение" /> Сухость/Шелушение</label><br />
                <label><input type="checkbox" name="Problems" value="Расширенные поры" /> Расширенные поры</label><br />
                <label><input type="checkbox" name="Problems" value="Отечность" /> Отечность</label><br />
                <label><input type="checkbox" name="Problems" value="Неровный тон кожи" /> Неровный тон кожи</label>
            </div>
        </div>

        <div class="step" data-step="5" style="display:none;">
            <label>5. Есть ли у вас аллергия на компоненты? (можно несколько)</label>
            <div>
                <label><input type="checkbox" name="Allergies" value="Нет" /> Нет</label><br />
                <label><input type="checkbox" name="Allergies" value="Парабены" /> Парабены</label><br />
                <label><input type="checkbox" name="Allergies" value="Отдушки (ароматизаторы)" /> Отдушки</label><br />
                <label><input type="checkbox" name="Allergies" value="Спирт (алкоголь)" /> Спирт</label><br />
                <label><input type="checkbox" name="Allergies" value="Силиконы" /> Силиконы</label><br />
                <label><input type="checkbox" name="Allergies" value="Сульфаты (SLS/SLES)" /> Сульфаты</label><br />
                <label><input type="checkbox" name="Allergies" value="Глютен" /> Глютен</label><br />
                <label><input type="checkbox" name="Allergies" value="Орехи и их производные" /> Орехи</label><br />
                <label><input type="checkbox" name="Allergies" value="Эфирные масла" /> Эфирные масла</label>
            </div>
        </div>

        <div class="step" data-step="6" style="display:none;">
            <label>6. Для какого сезона подбираете уход?</label>
            <div>
                <label><input type="radio" name="Season" value="Лето" /> Лето</label><br />
                <label><input type="radio" name="Season" value="Зима" /> Зима</label><br />
                <label><input type="radio" name="Season" value="Демисезон" /> Демисезон</label><br />
                <label><input type="radio" name="Season" value="Круглый год" /> Круглый год</label>
            </div>
        </div>

        <div class="step" data-step="7" style="display:none;">
            <label>7. Каким брендам доверяете? (через запятую)</label>
            <input type="text" name="FavoriteBrands" class="form-control" placeholder="Например: Librederm, Avene" />
        </div>

        <div class="step" data-step="8" style="display:none;">
            <label>8. Какая цель ухода? (можно несколько)</label>
            <div>
                <label><input type="checkbox" name="Goal" value="Увлажнение" /> Увлажнение</label><br />
                <label><input type="checkbox" name="Goal" value="Питание" /> Питание</label><br />
                <label><input type="checkbox" name="Goal" value="Антивозрастной" /> Антивозрастной</label><br />
                <label><input type="checkbox" name="Goal" value="Очищение" /> Очищение</label><br />
                <label><input type="checkbox" name="Goal" value="Защита" /> Защита</label><br />
                <label><input type="checkbox" name="Goal" value="Восстановление" /> Восстановление</label><br />
                <label><input type="checkbox" name="Goal" value="Матирование" /> Матирование</label><br />
                <label><input type="checkbox" name="Goal" value="Лифтинг (подтяжка)" /> Лифтинг (подтяжка)</label><br />
                <label><input type="checkbox" name="Goal" value="Осветление пигментации" /> Осветление пигментации</label><br />
                <label><input type="checkbox" name="Goal" value="Сужение пор" /> Сужение пор</label><br />
                <label><input type="checkbox" name="Goal" value="Сияние / здоровый вид" /> Сияние / здоровый вид</label><br />
                <label><input type="checkbox" name="Goal" value="Снятие стресса и успокоение" /> Снятие стресса и успокоение</label>
            </div>
        </div>

        <div class="step" data-step="9" style="display:none;">
            <label>9. Какой у вас уровень стресса?</label>
            <div>
                <label><input type="radio" name="StressLevel" value="Низкий" /> Низкий</label><br />
                <label><input type="radio" name="StressLevel" value="Средний" /> Средний</label><br />
                <label><input type="radio" name="StressLevel" value="Высокий" /> Высокий</label>
            </div>
        </div>

        <div class="step" data-step="10" style="display:none;">
            <label>10. Как обычно выглядит ваш рацион?</label>
            <div>
                <label><input type="radio" name="DietType" value="Сбалансированное питание" /> Сбалансированное питание</label><br />
                <label><input type="radio" name="DietType" value="Часто ем сладкое или жирное" /> Часто сладкое/жирное</label><br />
                <label><input type="radio" name="DietType" value="Стараюсь питаться правильно, но срываюсь" /> Стараюсь, но срываюсь</label><br />
                <label><input type="radio" name="DietType" value="У меня особый режим питания" /> Особый режим</label><br />
                <label><input type="radio" name="DietType" value="Вегетарианство" /> Вегетарианство</label>
            </div>
        </div>

        <div class="step" data-step="11" style="display:none;">
            <label>11. Есть ли у вас чувствительность к солнцу?</label>
            <div>
                <label><input type="radio" name="SunSensitivity" value="true" /> Да</label><br />
                <label><input type="radio" name="SunSensitivity" value="false" /> Нет</label>
            </div>
        </div>

        <div class="step" data-step="12" style="display:none;">
            <label>12. Склонны ли вы к отёкам по утрам?</label>
            <div>
                <label><input type="radio" name="TendencyToEdema" value="true" /> Да</label><br />
                <label><input type="radio" name="TendencyToEdema" value="false" /> Нет</label>
            </div>
        </div>

        <div class="step" data-step="13" style="display:none;">
            <label>13. Делаете ли вы профессиональный уход (чистки, пилинги)?</label>
            <div>
                <label><input type="radio" name="HasProfessionalCare" value="true" /> Да</label><br />
                <label><input type="radio" name="HasProfessionalCare" value="false" /> Нет</label>
            </div>
        </div>

        <div class="step" data-step="14" style="display:none;">
            <label>14. Какую текстуру средств вы предпочитаете?</label>
            <div>
                <label><input type="radio" name="TexturePreference" value="Лёгкая" /> Лёгкая (гели, флюиды)</label><br />
                <label><input type="radio" name="TexturePreference" value="Плотная" /> Плотная (кремы, масла)</label><br />
                <label><input type="radio" name="TexturePreference" value="Любая" /> Любая</label>
            </div>
        </div>

        <div class="step" data-step="15" style="display:none;">
            <label>15. Готовы ли вы к многоступенчатому уходу?</label>
            <div>
                <label><input type="radio" name="ReadyForMultiStep" value="true" /> Да</label><br />
                <label><input type="radio" name="ReadyForMultiStep" value="false" /> Нет</label>
            </div>
        </div>

        <div style="margin-top: 20px; display: flex; gap: 10px;">
            <button type="button" id="backBtn" class="btn btn-secondary" style="display:none;">Назад</button>
            <button type="button" id="nextBtn" class="btn btn-primary">Продолжить</button>
        </div>
    </form>
</div>

<script src="~/js/quiz.js"></script>