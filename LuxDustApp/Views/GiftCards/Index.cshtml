@{
    ViewData["Title"] = "Подарочные карты";
}

<div class="container">
    <h2>Подарочные карты</h2>

    <div class="giftcards-intro">
        <p>Подарите уход, который подойдёт. Подарочная карта LuxDust — это выбор без ошибок.</p>
    </div>

    <div class="giftcards-grid">
        <div class="giftcard-option">
            <div class="giftcard-icon">✦</div>
            <div class="giftcard-amount">1000 ₽</div>
            <form method="post" action="/GiftCards/Buy">
                <input type="hidden" name="amount" value="1000" />
                <button type="submit" class="btn btn-primary">Выбрать</button>
            </form>
        </div>

        <div class="giftcard-option featured">
            <div class="giftcard-icon">✦</div>
            <div class="giftcard-amount">3000 ₽</div>
            <form method="post" action="/GiftCards/Buy">
                <input type="hidden" name="amount" value="3000" />
                <button type="submit" class="btn btn-primary">Выбрать</button>
            </form>
        </div>

        <div class="giftcard-option">
            <div class="giftcard-icon">✦</div>
            <div class="giftcard-amount">5000 ₽</div>
            <form method="post" action="/GiftCards/Buy">
                <input type="hidden" name="amount" value="5000" />
                <button type="submit" class="btn btn-primary">Выбрать</button>
            </form>
        </div>
    </div>

    <div class="giftcards-steps">
        <h4>Как это работает</h4>
        <div class="giftcards-steps-row">
            <div class="giftcard-step">
                <div class="giftcard-step-num">01</div>
                <p>Выбираете номинал</p>
            </div>
            <div class="giftcard-step">
                <div class="giftcard-step-num">02</div>
                <p>Получаете уникальный код</p>
            </div>
            <div class="giftcard-step">
                <div class="giftcard-step-num">03</div>
                <p>Применяете при оформлении заказа</p>
            </div>
        </div>
    </div>
</div>