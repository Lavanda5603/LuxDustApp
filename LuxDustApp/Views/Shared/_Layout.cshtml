<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - LuxDust</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/pages.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#1a0b1f" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container navbar-container">
            <a class="navbar-brand" href="/">LuxDust</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/">Главная</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Quiz/Step1">Анкета</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Quiz/Cart">Корзина</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Catalog">Каталог</a></li>
                    @if (User.Identity.IsAuthenticated)
                    {
                    <li class="nav-item"><a class="nav-link" href="/Account/Profile">Личный кабинет</a></li>
                    @if (User.IsInRole("Admin"))
                    {
                    <li class="nav-item"><a class="nav-link" href="/Admin">Админка</a></li>
                    }
                    <li class="nav-item">
                        <a class="nav-link" href="#" onclick="if(confirm('Вы уверены, что хотите выйти?')) { window.location.href='/Account/Logout'; } return false;">
                            Выйти (@User.Identity.Name)
                        </a>
                    </li>
                    }
                    else
                    {
                    <li class="nav-item"><a class="nav-link" href="/Account/Login">Войти</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Account/Register">Регистрация</a></li>
                    }
                </ul>
                <button id="installPwaBtn" class="btn btn-sm" style="display:none; margin-left: 10px;">
                    Установить
                </button>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="text-center">
        &copy; 2026 LuxDust — искусство совершенства
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>