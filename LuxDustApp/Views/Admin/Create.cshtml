@{
    ViewData["Title"] = "Добавить товар";
}
@model LuxDustApp.Models.AdminProductViewModel

<div class="container">
    <h2>Добавить товар</h2>

    @if (!ViewData.ModelState.IsValid)
    {
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
        <p>@error.ErrorMessage</p>
        }
    </div>
    }

    <form method="post" action="/Admin/Create">
        <div class="mb-3">
            <label>Название</label>
            <input type="text" name="Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label>Бренд</label>
            <input type="text" name="Brand" class="form-control" list="brandsList" required />
            <datalist id="brandsList">
                @foreach (var brand in Model.Brands)
                {
                <option value="@brand"></option>
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label>Категория</label>
            <input type="text" name="Category" id="categoryInput" class="form-control" list="categoriesList" required />
            <datalist id="categoriesList">
                @foreach (var cat in Model.Categories)
                {
                <option value="@cat"></option>
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label>Подкатегория</label>
            <input type="text" name="SubCategory" class="form-control" list="subcategoriesList" />
            <datalist id="subcategoriesList">
                @foreach (var kvp in Model.SubcategoriesByCategory)
                {
                foreach (var sub in kvp.Value)
                {
                <option value="@sub" data-category="@kvp.Key"></option>
                }
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label>Цена (шаг 100 руб.)</label>
            <input type="number" name="Price" class="form-control" step="100" min="0" required />
        </div>

        <div class="mb-3">
            <label>Тип кожи</label>
            <select name="SkinType" class="form-select">
                @foreach (var skin in Model.SkinTypes)
                {
                <option value="@skin">@skin</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Проблема</label>
            <select name="Problem" class="form-select">
                @foreach (var problem in Model.Problems)
                {
                <option value="@problem">@problem</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Сезон</label>
            <select name="Season" class="form-select">
                @foreach (var season in Model.Seasons)
                {
                <option value="@season">@season</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label>Описание</label>
            <textarea name="Description" class="form-control"></textarea>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="IsNew" value="true" class="form-check-input" id="isNewCheck" />
            <label class="form-check-label" for="isNewCheck">Новинка</label>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" name="IsOnSale" value="true" class="form-check-input" id="isOnSaleCheck" />
            <label class="form-check-label" for="isOnSaleCheck">Акция</label>
        </div>

        <button type="submit" class="btn btn-success">Сохранить</button>
        <a href="/Admin" class="btn btn-secondary">Назад</a>
    </form>
</div>