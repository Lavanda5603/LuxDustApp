@{
    ViewData["Title"] = "Редактировать товар";
}
@model LuxDustApp.Models.AdminProductViewModel

<div class="container">
    <h2>Редактировать товар</h2>

    @if (!ViewData.ModelState.IsValid)
    {
    <div class="alert alert-danger">
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
        <p>@error.ErrorMessage</p>
        }
    </div>
    }

    <form method="post" action="/Admin/Edit" enctype="multipart/form-data" class="admin-form">
        <input type="hidden" asp-for="Product.Id" />
        <input type="hidden" asp-for="Product.CreatedAt" />
        <input type="hidden" asp-for="Product.Rating" />
        <input type="hidden" asp-for="Product.ImageUrl" />

        <div class="mb-3">
            <label class="form-label-lux">Название</label>
            <input type="text" asp-for="Product.Name" class="form-control" required />
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Бренд</label>
            <input type="text" asp-for="Product.Brand" class="form-control" list="brandsList" required />
            <datalist id="brandsList">
                @foreach (var brand in Model.Brands)
                {
                <option value="@brand"></option>
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Категория</label>
            <input type="text" asp-for="Product.Category" class="form-control" list="categoriesList" required />
            <datalist id="categoriesList">
                @foreach (var cat in Model.Categories)
                {
                <option value="@cat"></option>
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Подкатегория</label>
            <input type="text" asp-for="Product.SubCategory" class="form-control" list="subcategoriesList" />
            <datalist id="subcategoriesList">
                @foreach (var kvp in Model.SubcategoriesByCategory)
                {
                foreach (var sub in kvp.Value)
                {
                <option value="@sub" data-category="@kvp.Key"></option>
                }
                }
            </datalist>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Цена</label>
            <input type="number" asp-for="Product.Price" class="form-control price-no-arrows" min="0" required />
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Тип кожи</label>
            <select asp-for="Product.SkinType" class="form-select">
                @foreach (var skin in Model.SkinTypes)
                {
                <option value="@skin" selected="@(skin == Model.Product.SkinType)">@skin</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Проблема</label>
            <select asp-for="Product.Problem" class="form-select">
                @foreach (var problem in Model.Problems)
                {
                <option value="@problem" selected="@(problem == Model.Product.Problem)">@problem</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Сезон</label>
            <select asp-for="Product.Season" class="form-select">
                @foreach (var season in Model.Seasons)
                {
                <option value="@season" selected="@(season == Model.Product.Season)">@season</option>
                }
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Описание</label>
            <textarea asp-for="Product.Description" class="form-control"></textarea>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Текущее фото</label>
            <div class="admin-image-preview">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl) && Model.Product.ImageUrl != "/images/default.jpg")
                {
                <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" />
                <div>
                    <span class="current-image-label">Текущее фото</span>
                    <div class="remove-image-check form-check">
                        <input type="checkbox" asp-for="RemoveImage" class="form-check-input" id="removeImageCheck" />
                        <label class="form-check-label" for="removeImageCheck">Удалить текущее фото</label>
                    </div>
                </div>
                }
                else
                {
                <span class="no-image-text">Фото не загружено</span>
                }
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label-lux">Загрузить новое фото</label>
            <input type="file" asp-for="ImageFile" class="form-control" accept="image/*" />
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" asp-for="Product.IsNew" class="form-check-input" id="isNewCheck" />
            <label class="form-check-label" for="isNewCheck">Новинка</label>
        </div>

        <div class="mb-3 form-check">
            <input type="checkbox" asp-for="Product.IsOnSale" class="form-check-input" id="isOnSaleCheck" />
            <label class="form-check-label" for="isOnSaleCheck">Акция</label>
        </div>

        <button type="submit" class="btn btn-warning">Сохранить</button>
        <a href="/Admin" class="btn btn-secondary">Назад</a>
    </form>
</div>

@section Scripts {
<script src="~/js/admin-category.js"></script>
}