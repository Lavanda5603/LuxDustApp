@{
    ViewData["Title"] = "Админ-панель";
}
@model List<LuxDustApp.Models.Product>

    <div class="container">
        <h2>Админ-панель</h2>

        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Всего товаров</h5>
                        <p class="display-6" id="totalProductsCount">@ViewBag.TotalProducts</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Пользователей</h5>
                        <p class="display-6">@ViewBag.TotalUsers</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card text-center">
                    <div class="card-body">
                        <h5>Заказов</h5>
                        <p class="display-6">@ViewBag.TotalOrders</p>
                    </div>
                </div>
            </div>
        </div>

        <a href="/Admin/Create" class="btn btn-success mb-4">Добавить товар</a>

        <div class="admin-search-panel">
            <div class="row g-3">
                <div class="col-md-5">
                    <label class="form-label-lux">Поиск по названию</label>
                    <input type="text" id="adminSearchInput" class="form-control"
                           placeholder="Поиск по названию" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label-lux">Бренд</label>
                    <select id="adminBrandFilter" class="form-select">
                        <option value="">Все бренды</option>
                        @foreach (var brand in (List
                        <string>
                            )ViewBag.AllBrands)
                            {
                            <option value="@brand">@brand</option>
                            }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label-lux">Категория</label>
                    <select id="adminCategoryFilter" class="form-select">
                        <option value="">Все категории</option>
                        @foreach (var cat in (List
                        <string>
                            )ViewBag.AllCategories)
                            {
                            <option value="@cat">@cat</option>
                            }
                    </select>
                </div>
            </div>

            <div class="catalog-filters mt-3">
                <a href="#" class="filter-btn active" data-filter="">Все товары</a>
                <a href="#" class="filter-btn" data-filter="new">Новинки</a>
                <a href="#" class="filter-btn" data-filter="sale">Акции</a>
            </div>

            <p class="catalog-count mt-3 mb-0">
                Найдено: <strong id="adminFoundCount">@ViewBag.TotalProducts</strong>
            </p>
        </div>

        <table class="table mt-3">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Название</th>
                    <th>Бренд</th>
                    <th>Цена</th>
                    <th>Категория</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody id="adminProductsBody">
                @await Html.PartialAsync("_AdminProductRows", Model)
            </tbody>
        </table>
    </div>

    @section Scripts {
        <script src="~/js/admin-search.js"></script>
    }
