@{
    ViewData["Title"] = "Главная — LuxDust";
}

@section Styles {
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

@section Scripts {
<script src="~/js/home.js"></script>
}

<section class="hero-section">
    <div class="hero-bg-glow"></div>
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6 hero-text fade-in">
                <p class="hero-tagline">Умный подбор косметики</p>
                <h1 class="hero-title">
                    Твоя кожа.<br>
                    <span class="gold-text">Твои правила.</span>
                </h1>
                <p class="hero-subtitle">
                    15 вопросов — и алгоритм подберёт уход, который подойдёт именно тебе.
                    Без консультантов, без наугад, без лишних трат.
                </p>
                <div class="hero-buttons">
                    @if (User.Identity.IsAuthenticated)
                    {
                    <a href="/Quiz/Step1" class="btn-lux-primary">Пройти анкету</a>
                    <a href="/Account/Profile" class="btn-lux-outline">Личный кабинет</a>
                    }
                    else
                    {
                    <a href="/Quiz/Step1" class="btn-lux-primary">Начать подбор</a>
                    <a href="/Catalog" class="btn-lux-outline">Смотреть каталог</a>
                    }
                </div>
            </div>
            <div class="col-lg-6 hero-visual fade-in">
                <div class="drop-container">
                    <div class="drop-bg"></div>
                    @{
                    var heroImagePath = "/images/hero/hero-product.png";
                    var heroImageExists = System.IO.File.Exists(System.IO.Path.Combine(System.IO.Directory.GetCurrentDirectory(), "wwwroot", "images", "hero", "hero-product.png"));
                    }
                    @if (heroImageExists)
                    {
                    <img src="@heroImagePath" alt="Косметика" class="drop-image" />
                    }
                    else
                    {
                    <div class="drop-fallback"></div>
                    }
                </div>
            </div>
        </div>
        <div class="marquee">
            <div class="marquee-content">
                <span>увлажнение</span><span>•</span>
                <span>антивозрастной уход</span><span>•</span>
                <span>чувствительная кожа</span><span>•</span>
                <span>акне</span><span>•</span>
                <span>купероз</span><span>•</span>
                <span>SPF</span><span>•</span>
                <span>сыворотки</span><span>•</span>
                <span>тоники</span><span>•</span>
                <span>маски</span><span>•</span>
                <span>уход за глазами</span><span>•</span>
                <span>увлажнение</span><span>•</span>
                <span>антивозрастной уход</span><span>•</span>
                <span>чувствительная кожа</span><span>•</span>
                <span>акне</span><span>•</span>
                <span>купероз</span><span>•</span>
                <span>SPF</span><span>•</span>
            </div>
        </div>
    </div>
</section>

<section class="how-section">
    <div class="container">
        <div class="section-header fade-in">
            <p class="section-tagline">Как это работает</p>
            <h2 class="section-title">Три шага до идеального ухода</h2>
        </div>
        <div class="how-timeline">
            <div class="how-step fade-in">
                <div class="how-step-icon">01</div>
                <h3>Заполни анкету</h3>
                <p>15 вопросов о коже, бюджете и образе жизни. Займёт 3–5 минут.</p>
            </div>
            <div class="how-step fade-in">
                <div class="how-step-icon">02</div>
                <h3>Получи подборку</h3>
                <p>Алгоритм сравнит 500+ продуктов по 16 факторам и покажет ТОП-10.</p>
            </div>
            <div class="how-step fade-in">
                <div class="how-step-icon">03</div>
                <h3>Закажи или сохрани</h3>
                <p>Добавь в корзину, избранное или сохрани подборку в личном кабинете.</p>
            </div>
        </div>
    </div>
</section>

<section class="stats-section stats-block">
    <div class="container">
        <div class="row text-center g-4">
            <div class="col-6 col-md-3 fade-in">
                <div class="stat-number gold-text" data-target="15" data-suffix="">0</div>
                <div class="stat-label">параметров в анкете</div>
            </div>
            <div class="col-6 col-md-3 fade-in">
                <div class="stat-number gold-text" data-target="500" data-suffix="+">0</div>
                <div class="stat-label">продуктов в базе</div>
            </div>
            <div class="col-6 col-md-3 fade-in">
                <div class="stat-number gold-text" data-target="16" data-suffix="">0</div>
                <div class="stat-label">факторов в алгоритме</div>
            </div>
            <div class="col-6 col-md-3 fade-in">
                <div class="stat-number gold-text" data-target="30" data-suffix="%">0</div>
                <div class="stat-label">экономия бюджета</div>
            </div>
        </div>
    </div>
</section>

<section class="promo-section">
    <div class="container">
        <div class="section-header fade-in">
            <p class="section-tagline">Выгодно и свежо</p>
            <h2 class="section-title">Акции и новинки</h2>
        </div>

        @{
        var saleProducts = ViewBag.SaleProducts as List<LuxDustApp.Models.Product>
            ;
            var newProducts = ViewBag.NewProducts as List<LuxDustApp.Models.Product>
                ;
                }

                <div class="promo-scroll-wrapper fade-in">
                    <div class="promo-cards-wrapper" style="margin-bottom: 4rem;">
                        <div class="promo-card promo-sale">
                            <div>
                                <div class="promo-badge">Акция</div>
                                <h3>Скидки до 40%</h3>
                                <p>На хиты ухода за лицом. Успей до конца месяца.</p>
                            </div>
                            <a href="/Catalog?filter=sale" class="btn-lux-outline btn-sm">Смотреть все акции</a>
                        </div>

                        <div class="promo-divider">
                            <span>✦</span>
                        </div>

                        <div class="promo-card promo-new">
                            <div>
                                <div class="promo-badge">Новинка</div>
                                <h3>Свежие поступления</h3>
                                <p>Новые сыворотки, кремы и тоники уже в каталоге.</p>
                            </div>
                            <a href="/Catalog?filter=new" class="btn-lux-outline btn-sm">Смотреть все новинки</a>
                        </div>
                    </div>

                    @if (saleProducts != null && saleProducts.Any())
                    {
                    <h4 class="mb-3" style="color: var(--gold); font-family: 'Playfair Display', serif; font-size: 2.0rem;">Акции</h4>
                    <div class="promo-scroll">
                        @foreach (var product in saleProducts)
                        {
                        <a href="/Catalog/Details/@product.Id" class="promo-scroll-item">
                            <div class="catalog-card">
                                <div class="catalog-card-info">
                                    <h5>@product.Name</h5>
                                    <div class="promo-item-brand">@product.Brand</div>
                                    <div class="promo-item-price">@product.Price ₽</div>
                                </div>
                                <div class="catalog-card-image">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl) && product.ImageUrl != "/images/default.jpg")
                                    {
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                    }
                                    else
                                    {
                                    <div class="no-image">✦</div>
                                    }
                                </div>
                            </div>
                        </a>
                        }
                    </div>
                    }

                    @if (newProducts != null && newProducts.Any())
                    {
                    <h4 class="mb-3 mt-4" style="color: var(--gold); font-family: 'Playfair Display', serif; font-size: 2.0rem;">Новинки</h4>
                    <div class="promo-scroll">
                        @foreach (var product in newProducts)
                        {
                        <a href="/Catalog/Details/@product.Id" class="promo-scroll-item">
                            <div class="catalog-card">
                                <div class="catalog-card-info">
                                    <h5>@product.Name</h5>
                                    <div class="promo-item-brand">@product.Brand</div>
                                    <div class="promo-item-price">@product.Price ₽</div>
                                </div>
                                <div class="catalog-card-image">
                                    @if (!string.IsNullOrEmpty(product.ImageUrl) && product.ImageUrl != "/images/default.jpg")
                                    {
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                    }
                                    else
                                    {
                                    <div class="no-image">✦</div>
                                    }
                                </div>
                            </div>
                        </a>
                        }
                    </div>
                    }
                </div>
    </div>
</section>

<section class="trends-section">
    <div class="container">
        <div class="section-header fade-in">
            <p class="section-tagline">Что выбирают</p>
            <h2 class="section-title">Тренды ухода</h2>
        </div>

        @{
        var trends = new[]
        {
        new { Img = "/images/trends/probiotics.png", Alt = "Пробиотики", Title = "Пробиотики", Desc = "Восстанавливают микробиом кожи", Query = "пробиотик" },
        new { Img = "/images/trends/centella.png", Alt = "Центелла", Title = "Центелла азиатская", Desc = "Успокаивает и заживляет", Query = "центелл" },
        new { Img = "/images/trends/hyaluronic.png", Alt = "Гиалуроновая кислота", Title = "Гиалуроновая кислота", Desc = "Глубокое увлажнение", Query = "гиалурон" }
        };
        }

        <div class="row g-4">
            @foreach (var t in trends)
            {
            <div class="col-md-4 fade-in">
                <a href="/Catalog?search=@t.Query" class="trend-card">
                    <div class="trend-image-wrapper">
                        <img src="@t.Img" alt="@t.Alt" class="trend-image"
                             onerror="this.style.display='none'; this.parentElement.innerHTML='<div class=&quot;trend-image&quot; style=&quot;display:flex;align-items:center;justify-content:center;font-size:4rem;color:var(--gold);opacity:0.4;&quot;>✦</div>';" />
                    </div>
                    <div class="trend-content">
                        <h4>@t.Title</h4>
                        <p>@t.Desc</p>
                    </div>
                </a>
            </div>
            }
        </div>
    </div>
</section>

<section class="features-section">
    <div class="container">
        <div class="section-header fade-in">
            <p class="section-tagline">Почему LuxDust</p>
            <h2 class="section-title">Уникальные особенности</h2>
        </div>
        <div class="features-grid">
            <div class="feature-item fade-in">
                <div class="feature-icon-lux">✦</div>
                <h5>Точный подбор</h5>
                <p>16 факторов, а не 2–3 фильтра</p>
            </div>
            <div class="feature-item fade-in">
                <div class="feature-icon-lux">✦</div>
                <h5>Прозрачность</h5>
                <p>Видно, почему продукт подходит</p>
            </div>
            <div class="feature-item fade-in">
                <div class="feature-icon-lux">✦</div>
                <h5>PWA</h5>
                <p>Устанавливается на телефон</p>
            </div>
            <div class="feature-item fade-in">
                <div class="feature-icon-lux">✦</div>
                <h5>История</h5>
                <p>Все подборки сохраняются</p>
            </div>
        </div>
    </div>
</section>

<section class="preview-section">
    <div class="container">
        <div class="section-header fade-in">
            <p class="section-tagline">Пример подборки</p>
            <h2 class="section-title">ТОП-10 за 2 секунды</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4 fade-in">
                <div class="product-preview score-high">
                    <div class="product-score">125 баллов</div>
                    <h4>Сыворотка с морским коллагеном</h4>
                    <p class="product-brand">La Roche-Posay</p>
                    <p class="product-price">3000 ₽</p>
                    <p class="product-reason">обезвоженная кожа требует увлажнения</p>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="product-preview score-high">
                    <div class="product-score">112 баллов</div>
                    <h4>Сыворотка с центеллой</h4>
                    <p class="product-brand">Avene</p>
                    <p class="product-price">2300 ₽</p>
                    <p class="product-reason">связано с «Купероз»</p>
                </div>
            </div>
            <div class="col-md-4 fade-in">
                <div class="product-preview score-high">
                    <div class="product-score">107 баллов</div>
                    <h4>Крем с центеллой</h4>
                    <p class="product-brand">La Roche-Posay</p>
                    <p class="product-price">2300 ₽</p>
                    <p class="product-reason">решает вашу главную проблему</p>
                </div>
            </div>
        </div>
        <div class="text-center mt-4 fade-in">
            <p class="preview-note">Так выглядит подборка. Алгоритм объясняет, <strong>почему</strong> этот продукт тебе подходит.</p>
        </div>
    </div>
</section>

<section class="cta-section">
    <div class="container text-center fade-in">
        <h2 class="cta-title">Перестань угадывать.<br><span class="gold-text">Начни подбирать.</span></h2>
        <p class="cta-subtitle">3–5 минут — и ты знаешь, что действительно подходит твоей коже.</p>
        <div class="cta-buttons">
            @if (User.Identity.IsAuthenticated)
            {
            <a href="/Quiz/Step1" class="btn-lux-primary">Пройти анкету заново</a>
            <a href="/Account/Profile" class="btn-lux-outline">Личный кабинет</a>
            }
            else
            {
            <a href="/Quiz/Step1" class="btn-lux-primary">Начать подбор</a>
            <a href="/Account/Login" class="btn-lux-outline">Уже есть аккаунт? Войти</a>
            }
        </div>
    </div>
</section>