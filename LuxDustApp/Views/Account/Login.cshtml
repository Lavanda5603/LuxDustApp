@model LuxDustApp.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход";
}

<div class="container" style="max-width: 500px;">
    <h2>Вход</h2>

    <!-- Форма входа -->
    <form method="post" action="/Account/Login">

        <!-- Email -->
        <div class="mb-3">
            <label class="form-label-lux">Email</label>
            <input type="email" asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <!-- Пароль -->
        <div class="mb-3">
            <label class="form-label-lux">Пароль</label>
            <input type="password" asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <!-- Общая ошибка (неверный email или пароль) -->
        @if (ViewData.ModelState[""] != null && ViewData.ModelState[""].Errors.Count > 0)
        {
        <div class="alert alert-danger">
            @ViewData.ModelState[""].Errors.First().ErrorMessage
        </div>
        }

        <button type="submit" class="btn btn-primary">Войти</button>
        <a href="/Account/Register" class="btn btn-link">Нет аккаунта? Зарегистрироваться</a>
    </form>
</div>