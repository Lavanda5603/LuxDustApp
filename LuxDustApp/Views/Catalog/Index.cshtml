@{
    ViewData["Title"] = "Каталог";
}
@model List<LuxDustApp.Models.Product>

    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h4>Категории</h4>
                <ul class="list-group">
                    @foreach (var cat in (List
                    <string>
                        )ViewBag.Categories)
                        {
                        var subs = ((Dictionary<string, List<string>>)ViewBag.SubcategoriesByCategory)[cat];
                    <li class="list-group-item p-0">
                        <div class="d-flex justify-content-between align-items-center p-2">
                            <a href="/Catalog?category=@cat" class="text-decoration-none flex-grow-1">@cat</a>
                            @if (subs.Any())
                            {
                                <span onclick="toggleSubs('@cat.Replace(" ", "_")')">▼</span>
                            }
                        </div>
                        @if (subs.Any())
                        {
                            <ul class="list-unstyled ps-3 pb-2" id="subs-@cat.Replace(" ", "_")" style="display:none;">
                                @foreach (var sub in subs)
                                {
                                    <li>
                                        <a href="/Catalog?category=@cat&subcategory=@sub">— @sub</a>
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
                </ul>
            </div>

            <div class="col-md-9">
                <h2>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSubcategory))
                    {
                    @ViewBag.CurrentSubcategory
                    }
                    else if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
                    {
                    @ViewBag.CurrentCategory
                    }
                    else
                    {
                    <span>Все товары</span>
                    }
                </h2>

                <div class="row g-2 mb-4">
                    <input type="hidden" id="currentCategory" value="@ViewBag.CurrentCategory" />
                    <input type="hidden" id="currentSubcategory" value="@ViewBag.CurrentSubcategory" />
                    <div class="col-md-5">
                        <input type="text" id="searchInput" class="form-control" placeholder="Поиск по названию..." value="@ViewBag.CurrentSearch" autocomplete="off" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="minPrice" class="form-control" placeholder="Цена от" value="@ViewBag.MinPrice" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" id="maxPrice" class="form-control" placeholder="Цена до" value="@ViewBag.MaxPrice" />
                    </div>
                </div>

                <p class="catalog-count">Найдено товаров: @ViewBag.TotalItems</p>

                <div id="productsContainer">
                    @await Html.PartialAsync("_ProductCards", Model)
                </div>

                @if (ViewBag.TotalPages > 1)
                {
                <nav>
                    <ul class="pagination justify-content-center">
                        @{
                        int currentPage = ViewBag.CurrentPage;
                        int totalPages = ViewBag.TotalPages;
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, startPage + 4);
                        if (endPage - startPage < 4)
                        {
                        startPage = Math.Max(1, endPage - 4);
                        }
                        string BuildUrl(int p) => $"/Catalog?category={ViewBag.CurrentCategory}&subcategory={ViewBag.CurrentSubcategory}&search={ViewBag.CurrentSearch}&minPrice={ViewBag.MinPrice}&maxPrice={ViewBag.MaxPrice}&page={p}";
                        }

                        @if (currentPage > 1)
                        {
                        <li class="page-item">
                            <a class="page-link" href="@BuildUrl(Math.Max(1, currentPage - 5))">← Назад</a>
                        </li>
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                        <li class="page-item @(i == currentPage ? " active" : "" )">
                            <a class="page-link" href="@BuildUrl(i)">@i</a>
                        </li>
                        }

                        @if (currentPage < totalPages)
                        {
                        <li class="page-item">
                            <a class="page-link" href="@BuildUrl(Math.Min(totalPages, currentPage + 5))">Вперёд →</a>
                        </li>
                        }
                    </ul>
                </nav>
                }
            </div>
        </div>
    </div>

    @section Scripts {
    <script src="~/js/quiz.js"></script>
    <script src="~/js/catalog.js"></script>
    <script src="~/js/catalog-search.js"></script>
    }
