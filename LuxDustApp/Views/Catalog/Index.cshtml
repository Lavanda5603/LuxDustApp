@{
    ViewData["Title"] = "Каталог";
}
@model List<LuxDustApp.Models.Product>

    <div class="container">
        <div class="row">
            <div class="col-md-3">
                <h4>Категории</h4>
                <ul class="list-group mb-3">
                    @foreach (var cat in (List
                    <string>
                        )ViewBag.Categories)
                        {
                        <li class="list-group-item @(ViewBag.CurrentCategory == cat ? " active" : "" )">
                            <a href="/Catalog?category=@cat" style="text-decoration: none; color: inherit;">@cat</a>
                        </li>
                        }
                </ul>

                @if (ViewBag.Subcategories != null && ((List<string>
                    )ViewBag.Subcategories).Any())
                    {
                    <h5>Подкатегории</h5>
                    <ul class="list-group">
                        @foreach (var sub in (List
                        <string>
                            )ViewBag.Subcategories)
                            {
                            <li class="list-group-item @(ViewBag.CurrentSubcategory == sub ? " active" : "" )">
                                <a href="/Catalog?category=@ViewBag.CurrentCategory&subcategory=@sub" style="text-decoration: none; color: inherit;">@sub</a>
                            </li>
                            }
                    </ul>
                    }
            </div>

            <div class="col-md-9">
                <h2>
                    @if (!string.IsNullOrEmpty(ViewBag.CurrentSubcategory))
                    {
                    @ViewBag.CurrentSubcategory
                    }
                    else if (!string.IsNullOrEmpty(ViewBag.CurrentCategory))
                    {
                    @ViewBag.CurrentCategory
                    }
                    else
                    {
                    <span>Все товары</span>
                    }
                </h2>

                @if (Model != null && Model.Any())
                {
                <div class="row">
                    @foreach (var product in Model)
                    {
                    <div class="col-md-4 mb-4">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@product.Name</h5>
                                <p class="card-text">@product.Brand</p>
                                <p class="card-text"><strong>@product.Price руб.</strong></p>
                                @if (product.IsNew)
                                {
                                <span class="badge bg-success">Новинка</span>
                                }
                                @if (product.IsOnSale)
                                {
                                <span class="badge bg-danger">Акция</span>
                                }
                                <br /><br />
                                <a href="/Catalog/Details/@product.Id" class="btn btn-primary btn-sm">Подробнее</a>
                                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="addToCart(@product.Id, this)">В корзину</button>
                            </div>
                        </div>
                    </div>
                    }
                </div>
                }
                else
                {
                <p>Товары не найдены.</p>
                }
            </div>
        </div>
    </div>

    <script src="~/js/quiz.js"></script>
